# Einstellungen für das IONOS-Webhosting (Apache)

# Immer verschlüsselt (https) aufrufen
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Interne Dateien nicht öffentlich ausliefern
RewriteRule ^supabase/ - [R=404,L]
<FilesMatch "^(\.htaccess|\.gitignore|README\.md)$">
  Require all denied
</FilesMatch>

# Eigene Fehlerseite
ErrorDocument 404 /404.html

# Sicherheits-Header
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://qjrljfmoifkboucciabm.supabase.co wss://qjrljfmoifkboucciabm.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Dashboard nie in Suchmaschinen und nie zwischenspeichern
  <FilesMatch "^dashboard\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Cache-Control "no-store"
  </FilesMatch>
  <FilesMatch "^supabase-config\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Bilder und Schriften länger zwischenspeichern (schnellere Ladezeit)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
